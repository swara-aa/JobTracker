# Copy to .env for local reference only. Do not commit a real .env file.

# Optional Gemini features
GEMINI_API_KEY="replace-with-your-key"
GEMINI_MODEL="gemini-3.1-flash-lite"

# Required in a hosted deployment. The Azure deployment script generates this
# securely and stores it only in App Service settings.
FLASK_SECRET_KEY=
JOBTRACKER_DATA_DIR=data
JOBTRACKER_AUTOMATION_ENABLED=false
JOBTRACKER_AUTH_REQUIRED=false
JOBTRACKER_ACCESS_PASSWORD=
JOBTRACKER_EXTENSION_IMPORT_TOKEN=

# Optional local semantic matching
JOB_AGENT_ENABLE_LOCAL_EMBEDDINGS=0

# Optional company intelligence. The bundled CSV is manually maintained.
COMPANY_INTELLIGENCE_ENABLED=true
COMPANY_DATABASE_PATH=config/companies.csv

# Optional collection schedule and public job boards
JOB_AGENT_SCHEDULE_TIME=09:00
JOB_AGENT_PUBLIC_COLLECTION_TIME=07:56
JOB_AGENT_GREENHOUSE_BOARDS=board-token:Company Name
JOB_AGENT_LEVER_SITES=site-token:Company Name

# Optional email digest
JOB_AGENT_SMTP_HOST=
JOB_AGENT_SMTP_PORT=587
JOB_AGENT_SMTP_USERNAME=
JOB_AGENT_SMTP_PASSWORD=
JOB_AGENT_SMTP_TO=
